<section class="placeholder-page" aria-labelledby="placeholder-heading">
  <%= link_to root_path, class: "back-link" do %>
    <%= icon_tag "arrow-left" %>
    <span>Back home</span>
  <% end %>

  <div class="placeholder-page__card placeholder-page__card--<%= section.downcase %>">
    <p class="eyebrow"><%= number %> / Coming soon</p>
    <h1 id="placeholder-heading"><%= section %></h1>
    <p><%= description %></p>
    <span class="placeholder-page__mark" aria-hidden="true"><%= number %></span>
  </div>
</section>
