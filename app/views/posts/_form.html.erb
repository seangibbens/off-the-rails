<%= form_with(model: post, class: "post-form") do |form| %>
  <% if post.errors.any? %>
    <div id="error_explanation" class="notice notice--error" role="alert">
      <h2><%= pluralize(post.errors.count, "error") %> kept this post from being saved</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, class: "field__label" %>
    <%= form.text_field :title, class: ["field__input", { "field__input--invalid": post.errors[:title].any? }], autofocus: true, placeholder: "Give this post a clear title" %>
  </div>

  <div class="field">
    <%= form.label :body, class: "field__label" %>
    <%= form.rich_text_area :body, rows: 10, class: ["lexxy-content post-form__editor", { "post-form__editor--invalid": post.errors[:body].any? }], placeholder: "Write what is on your mind..." %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button button--primary" %>
    <%= link_to "Cancel", post.persisted? ? post_path(post) : posts_path, class: "button button--quiet" %>
  </div>
<% end %>
