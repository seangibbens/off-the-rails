<% content_for :title, "Edit #{@post.title.presence || "post"}" %>

<div class="editor-shell">
  <%= link_to @post, class: "back-link" do %>
    <%= icon_tag "arrow-left" %>
    <span>Back to post</span>
  <% end %>

  <header class="editor-header">
    <p class="eyebrow">Make it better</p>
    <h1>Edit post</h1>
  </header>

  <%= render "form", post: @post %>
</div>
