<% content_for :title, @post.title.presence || "Post" %>

<div class="editor-shell">
  <% if notice.present? %>
    <p class="notice notice--success" id="notice" role="status"><%= notice %></p>
  <% end %>

  <%= link_to posts_path, class: "back-link" do %>
    <%= icon_tag "arrow-left" %>
    <span>All posts</span>
  <% end %>

  <article class="post-detail">
    <p class="post-meta">
      <time datetime="<%= @post.created_at.iso8601 %>"><%= @post.created_at.to_fs(:long) %></time>
      <span aria-hidden="true">/</span>
      <%= link_to @post.user.username, user_path(@post.user.username) %>
    </p>
    <h1><%= @post.title.presence || "Untitled" %></h1>
    <div class="post-detail__body"><%= @post.body %></div>
  </article>

  <% if @post.user_id == Current.user.id %>
    <div class="detail-actions">
      <%= link_to edit_post_path(@post), class: "button button--quiet" do %>
        <%= icon_tag "edit" %>
        <span>Edit post</span>
      <% end %>
      <%= button_to @post, method: :delete, class: "button button--danger", data: { turbo_confirm: "Delete this post? This cannot be undone." } do %>
        <%= icon_tag "trash" %>
        <span>Delete post</span>
      <% end %>
    </div>
  <% end %>
</div>
