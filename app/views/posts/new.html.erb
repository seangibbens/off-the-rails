<% content_for :title, "New post" %>

<div class="editor-shell">
  <%= link_to posts_path, class: "back-link" do %>
    <%= icon_tag "arrow-left" %>
    <span>All posts</span>
  <% end %>

  <header class="editor-header">
    <p class="eyebrow">Start something</p>
    <h1>New post</h1>
    <p>Put the idea down now. You can always sharpen it later.</p>
  </header>

  <%= render "form", post: @post %>
</div>
