<% content_for :title, "Posts" %>

<section aria-labelledby="posts-heading">
  <% if notice.present? %>
    <p class="notice notice--success" id="notice" role="status"><%= notice %></p>
  <% end %>

  <header class="page-header">
    <div>
      <p class="eyebrow">The latest</p>
      <h1 id="posts-heading">Posts</h1>
      <p class="page-header__intro">Notes, ideas, and observations from off the beaten track.</p>
    </div>
    <%= link_to new_post_path, class: "button button--primary" do %>
      <%= icon_tag "add" %>
      <span>New post</span>
    <% end %>
  </header>

  <div id="posts" class="post-list">
    <% if @posts.any? %>
      <%= render @posts, compact: true %>
    <% else %>
      <div class="empty-state">
        <p class="empty-state__mark" aria-hidden="true">01</p>
        <h2>No posts yet</h2>
        <p>Every collection starts somewhere. Write the first note.</p>
        <%= link_to "Create the first post", new_post_path, class: "button button--primary" %>
      </div>
    <% end %>
  </div>
</section>
