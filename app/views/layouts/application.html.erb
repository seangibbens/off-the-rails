<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Off The Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Off The Rails">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "lexxy", "tailwind", "lexxy_overrides", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="theme">
    <button class="button button--icon theme-toggle" type="button" data-action="theme#toggle" data-theme-target="button" aria-label="Switch theme">
      <%= icon_tag "moon", class: "theme-toggle__moon" %>
      <%= icon_tag "sun", class: "theme-toggle__sun" %>
      <span class="for-screen-reader" data-theme-target="label">Switch theme</span>
    </button>

    <% if authenticated? %>
      <header class="app-header">
        <%= link_to "Off the Rails", root_path, class: "app-wordmark" %>
        <div class="app-header__actions">
          <div class="timezone-indicator" data-controller="timezone" aria-label="Detecting your timezone">
            <%= icon_tag "sun", class: "timezone-indicator__icon", data: { timezone_target: "sun" }, hidden: true %>
            <%= icon_tag "moon", class: "timezone-indicator__icon", data: { timezone_target: "moon" }, hidden: true %>
            <span data-timezone-target="label">Local time</span>
          </div>
          <span class="app-header__email"><%= Current.user.email_address %></span>
          <%= button_to "Sign out", session_path, method: :delete, class: "button button--quiet button--small" %>
        </div>
      </header>
    <% end %>

    <main class="<%= authenticated? ? "app-main" : "auth-main" %>">
      <%= yield %>
    </main>

    <% if authenticated? %>
      <footer class="app-footer">
        <div class="app-footer__intro">
          <p class="app-footer__name">Your Name</p>
          <p class="app-footer__bio">Personal info goes here.</p>
        </div>

        <nav class="app-footer__links" aria-label="Social links">
          <%= link_to "GitHub ->", "https://github.com/your-handle", class: "app-footer__link" %>
          <%= link_to "LinkedIn ->", "https://www.linkedin.com/in/your-handle", class: "app-footer__link" %>
        </nav>
      </footer>
    <% end %>
  </body>
</html>
